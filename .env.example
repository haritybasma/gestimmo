# --- Développement local (SQLite) -----------------------------------------
DATABASE_URL="file:./dev.db"

# --- Production (PostgreSQL) ------------------------------------------------
# 1) Dans prisma/schema.prisma, mettre provider = "postgresql"
# 2) Décommenter et renseigner l'URL ci-dessous :
# DATABASE_URL="postgresql://user:password@host:5432/gestimmo?schema=public"

# Clé de signature des sessions (générer une valeur aléatoire en prod :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"
